generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  accounts     Account[]
  trades       Trade[]
  preferences  UserPreference?
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dashboard Json?
  theme     String?  // 'light' | 'dark' | 'system'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])

  name           String
  externalId     String?  // Login METATRADER / Rithmic
  broker         String?
  currency       String   @default("USD")
  initialBalance Decimal  @db.Decimal(18,2)

  type           AccountType @default(PERSONAL)
  market         MarketType  @default(CFD)

  dailyLossLimit Decimal? @db.Decimal(18,2)
  maxLossLimit   Decimal? @db.Decimal(18,2)
  profitTarget   Decimal? @db.Decimal(18,2)
  defaultRisk    Decimal? @db.Decimal(18,2)

  startedAt      DateTime?
  status         String   @default("active") // active|archived
  propFirmStatus PropFirmStatus?
  createdAt      DateTime @default(now())
  deletedAt      DateTime?

  trades              Trade[]
  cycles              AccountCycle[]
  dailyStatuses       DailyAccountStatus[]
  stateSnapshot       AccountStateSnapshot?
  payoutRequests      PayoutRequest[]
}

enum PropFirmStatus {
  CHALLENGE
  FUNDED
}

model Trade {
  id         String   @id @default(uuid())
  userId     String
  accountId  String

  user       User     @relation(fields: [userId], references: [id])
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  instrument String
  side       String   // LONG|SHORT

  openAt     DateTime
  closeAt    DateTime?

  entryPrice Decimal? @db.Decimal(18,6)
  exitPrice  Decimal? @db.Decimal(18,6)

  quantity   Decimal  @db.Decimal(18,6)
  fees       Decimal  @default(0) @db.Decimal(18,2)
  swap       Decimal  @default(0) @db.Decimal(18,2)
  commission Decimal  @default(0) @db.Decimal(18,2)

  pnlGross   Decimal? @db.Decimal(18,2)
  pnlNet     Decimal  @db.Decimal(18,2)

  riskAmount Decimal? @db.Decimal(18,2)
  resultR    Decimal? @db.Decimal(18,4)

  externalId String?  // ID de la operación en MT5/ext (Position Ticket)

  notes      String?
  tags       String[] // MVP, luego normalizar

  createdAt  DateTime @default(now())
  deletedAt  DateTime?

  @@index([accountId, openAt])
  @@index([userId, openAt])
  @@index([externalId])
}

enum AccountType {
  PERSONAL
  PROP_FIRM
}

enum MarketType {
  CFD
  FUTURES
  SPOT
  CRYPTO
  STOCKS
}

// --- Funding (derived from accounts + trades, never modifies Trade) ---

enum OperationalState {
  BREAK_EVEN
  DRAWDOWN
  PROFIT
  PAYOUT_REQUESTED
  PAYOUT_PROCESSING
  CHALLENGE
}

enum CycleStatus {
  ACTIVE
  CLOSED
}

enum PayoutRequestStatus {
  REQUESTED
  PROCESSING
  PAID
}

enum CalendarEventType {
  NFP
  HOLIDAY
  WEEKEND
  CUSTOM
}

model AccountCycle {
  id                String      @id @default(uuid())
  accountId         String
  account           Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  startDate         DateTime    @db.Date
  endDate           DateTime?   @db.Date
  cycleStartBalance Decimal     @db.Decimal(18, 2)
  profitTargetPct   Decimal     @default(2) @db.Decimal(5, 2)
  status            CycleStatus @default(ACTIVE)

  dailyStatuses     DailyAccountStatus[]
  payoutRequests    PayoutRequest[]
  stateSnapshots    AccountStateSnapshot[]

  @@index([accountId, startDate])
  @@index([accountId, status])
}

model DailyAccountStatus {
  id                String           @id @default(uuid())
  accountId         String
  account           Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cycleId           String
  cycle             AccountCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  date              DateTime         @db.Date
  operationalState  OperationalState
  balanceEod        Decimal          @db.Decimal(18, 2)
  pnlDay            Decimal          @db.Decimal(18, 2)
  tradesCount       Int              @default(0)
  tags              String[]

  @@unique([accountId, date])
  @@index([cycleId, date])
  @@index([accountId, date])
}

model AccountStateSnapshot {
  id                    String            @id @default(uuid())
  accountId             String            @unique
  account               Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  currentCycleId        String?
  currentCycle          AccountCycle?     @relation(fields: [currentCycleId], references: [id], onDelete: SetNull)
  operationalState     OperationalState
  balance               Decimal           @db.Decimal(18, 2)
  cycleStartBalance     Decimal           @db.Decimal(18, 2)
  drawdownPct           Decimal           @default(0) @db.Decimal(8, 4)
  profitPct             Decimal           @default(0) @db.Decimal(8, 4)
  daysToPayoutEligible  Int?
  updatedAt             DateTime          @updatedAt
}

model PayoutRequest {
  id           String             @id @default(uuid())
  accountId    String
  account      Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cycleId      String
  cycle        AccountCycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  requestedAt  DateTime          @default(now())
  eligibleDate DateTime          @db.Date
  paidAt       DateTime?         @db.Date
  amount       Decimal?          @db.Decimal(18, 2)
  status       PayoutRequestStatus @default(REQUESTED)

  @@index([accountId, cycleId])
  @@index([status])
}

model CalendarEvent {
  id            String           @id @default(uuid())
  date          DateTime         @db.Date
  type          CalendarEventType
  label         String
  blocksTrading Boolean          @default(true)

  @@index([date])
}
